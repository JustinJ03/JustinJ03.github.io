---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ToolCarousel from '../components/ToolCarousel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Interests from '../components/Interests.astro';
import Contact from '../components/Contact.astro';
import { categories } from '../data/tools';
import { projects } from '../data/projects';
---
<BaseLayout>
  <Hero />
  <section class="section toolkit" aria-labelledby="toolkit-heading">
    <div class="section-heading"><p class="eyebrow">MY TOOLKIT</p><h2 id="toolkit-heading">Tools I build with<span class="accent">.</span></h2><p>Some familiar tools, and a few I'm still getting to know.</p></div>
    <p class="carousel-hint">Drag, swipe, or use the arrows to explore. Hover to take a closer look.</p>
    {categories.map((category) => <ToolCarousel category={category} />)}
  </section>
  <section id="projects" class="section projects" aria-labelledby="projects-heading">
    <div class="section-heading"><p class="eyebrow">LEARNING BY DOING</p><h2 id="projects-heading">Things I've built<span class="accent">.</span></h2><p>A few projects, and what I learned along the way.</p></div>
    <div class="project-grid grid grid-cols-1 md:grid-cols-2 gap-6">{projects.filter((project) => project.visible).map((project, index) => <ProjectCard project={project} index={index} />)}</div>
  </section>
  <Interests /><Contact />
</BaseLayout>
<script>import '../scripts/tool-carousel';</script>
