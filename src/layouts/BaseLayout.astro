---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { path } from '../utils/paths';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = 'Justin Joel — Software Engineering Portfolio', description = 'Step into my digital greenhouse: web and mobile development, practical projects, and ideas taking root. A portfolio by Justin Joel, Software Engineering student at UNIMAS.', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(path('images/social-preview.png'), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <meta name="theme-color" content="#183D32" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Justin Joel — Digital Greenhouse. Software Engineering, Web & Mobile." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={path('favicon.svg')} />
  </head>
  <body><Header /><main id="main" tabindex="-1"><slot /></main><Footer /></body>
</html>
