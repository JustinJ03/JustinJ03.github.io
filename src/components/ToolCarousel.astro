---
import { tools, type categories } from '../data/tools';
import ToolCard from './ToolCard.astro';
interface Props { category: (typeof categories)[number] }
const { category } = Astro.props;
---
<section class="tool-row" data-carousel data-label={category.controlName} aria-labelledby={`tools-${category.id}`}>
  <div class="row-heading">
    <div class="row-title"><h3 id={`tools-${category.id}`}>{category.name}</h3>{category.note && <span class="exploring-note">{category.note}</span>}</div>
    <div class="carousel-controls" data-controls hidden>
      <button type="button" data-previous aria-label={`Previous ${category.controlName}`} aria-controls={`viewport-${category.id}`}><span aria-hidden="true">←</span></button>
      <button type="button" class="motion-toggle" data-toggle aria-label={`Pause ${category.controlName}`} aria-controls={`viewport-${category.id}`}><span data-toggle-icon aria-hidden="true">Ⅱ</span><span data-toggle-text>Pause</span></button>
      <button type="button" data-next aria-label={`Next ${category.controlName}`} aria-controls={`viewport-${category.id}`}><span aria-hidden="true">→</span></button>
    </div>
  </div>
  <div class="carousel-viewport" id={`viewport-${category.id}`} data-viewport tabindex="0" aria-label={`${category.name}, horizontally scrollable tools`}>
    <ul class="tool-list" role="list">{tools.filter((tool) => tool.category === category.id).map((tool) => <ToolCard tool={tool} />)}</ul>
  </div>
</section>
