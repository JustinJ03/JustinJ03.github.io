---
import { profile } from '../data/profile';
import { getTool } from '../data/tools';
import ToolIcon from './ToolIcon.astro';
import { withBase } from '../utils/paths';
---
<section class="section contact" aria-labelledby="contact-heading">
  <p class="eyebrow">LET'S CONNECT</p>
  <h2 id="contact-heading">{profile.contact.heading}<span class="contact-spark" aria-hidden="true">↗</span></h2>
  <p>{profile.contact.description}</p>
  <div class="contact-links">
    <a class="button" href={profile.contact.linkedin}><img class="brand-icon compact" src={withBase('icons/brands/linkedin.png')} alt="" width="16" height="16" />LinkedIn <span aria-hidden="true">↗</span></a>
    <a class="button" href={profile.contact.github}><ToolIcon tool={getTool('github')} compact />GitHub <span aria-hidden="true">↗</span></a>
    <a class="button email-link" href={`mailto:${profile.contact.email}`}><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg><span>{profile.contact.email}</span></a>
  </div>
</section>
<footer class="site-footer"><span>© {new Date().getFullYear()} {profile.name}</span><span>Built with <a href="https://astro.build/">Astro</a> & <a href={getTool('tailwindcss').url}>Tailwind CSS</a></span></footer>
