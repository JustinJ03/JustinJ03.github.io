---
import { profile } from '../data/profile';
---
<footer class="container site-footer"><p>© {new Date().getFullYear()} {profile.name}<span>END OF LEVEL. KEEP EXPLORING.</span></p><div class="interface-controls" aria-label="Display settings"><button data-palette="cyan" aria-pressed="true" aria-label="Cyan neon palette" hidden><span class="palette-dot cyan"></span></button><button data-palette="pink" aria-pressed="false" aria-label="Pink neon palette" hidden><span class="palette-dot pink"></span></button><button data-palette="amber" aria-pressed="false" aria-label="Amber neon palette" hidden><span class="palette-dot amber"></span></button><button id="effects-toggle" aria-pressed="true" hidden>Motion: on</button></div><a href="#top">Back to top ↑</a></footer>
