---
import type { Tool } from '../data/tools';
import { withBase } from '../utils/paths';
interface Props { tool: Tool; compact?: boolean }
const { tool, compact = false } = Astro.props;
---
{tool.iconPath ? <img class:list={['brand-icon', { compact }]} src={withBase(tool.iconPath)} alt="" width="36" height="36" loading="lazy" draggable="false" /> : !compact && <span class="text-mark" aria-hidden="true">{tool.name}</span>}
