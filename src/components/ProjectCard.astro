---
import type { Project } from '../data/projects';
import { getTool } from '../data/tools';
import ToolIcon from './ToolIcon.astro';
interface Props { project: Project; index: number }
const { project, index } = Astro.props;
---
<article class="project-card" aria-labelledby={`project-${project.id}`}>
  <div class="project-top"><span class:list={['badge', `badge-${project.category.toLowerCase().replaceAll(' ', '-')}`]}>{project.category}</span><span class="project-number" aria-hidden="true">0{index + 1}</span></div>
  <h3 id={`project-${project.id}`}>{project.name}</h3>
  <p class="project-subtitle">{project.subtitle}</p>
  {project.context && <p class="project-context">{project.context}</p>}
  {project.lifecycle && <p class="project-context">{project.lifecycle}</p>}
  <p class="project-summary">{project.summary}</p>
  <h4>What it does</h4>
  <div class="project-stack"><h4>Built with</h4><ul class="tool-chips" role="list">
    {project.toolIds.map((id) => { const tool = getTool(id); return <li><a href={tool.url}><ToolIcon tool={tool} compact /><span>{project.toolLabels?.[id] || tool.name}</span></a></li>; })}
    {project.additionalTechnologyLinks?.map((tool) => <li><a href={tool.url}>{tool.name}</a></li>)}
  </ul></div>
  <footer class="repository-footer">{project.repoUrl ? <a href={project.repoUrl}>View repository on GitHub <span aria-hidden="true">↗</span></a> : <span class="repo-unavailable"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 3h12v18l-6-3-6 3zM9 7h6M9 10h4" /></svg>Repository link to be added</span>}</footer>
</article>
