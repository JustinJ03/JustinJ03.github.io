    <path d="M91 47h116v65h-66l-24 19v-19H91Z" fill="var(--surface)"/><path d="M111 67h72m-72 15h51"/>
    <path d="M166 94h70v49h-14v15l-21-15h-35Z" fill="var(--sage)"/><path d="M180 112h42m-42 13h28"/>
  </> : category === 'desktop' ? <>
    <path d="M104 45h112v79H104z" fill="var(--surface)"/><path d="M116 57h88v55h-88zM146 124v13h-18v7h64v-7h-18v-13"/>
    <path d="m143 84 11 11 23-24M91 144h138"/>
  </> : category === 'web' ? <>
    <path d="M99 124V56h91v68z" fill="var(--surface)"/><path d="M99 72h91m-78-8h2m7 0h2m7 0h2"/>
    <path d="M132 93h88v54h-88z" fill="var(--sage)"/><path d="m145 132 17-18 18 9 23-20m-10 0h10v10"/>
    <path d="M76 148h167M210 58v20m-10-10h20"/>
