    <rect x="130" y="33" width="63" height="116" rx="4" fill="var(--surface)"/><path d="M143 43h37m-39 11h41v75h-41zm12 86h16m-29-57h44m-30-15v30"/><path d="M210 71h15v43h-15m-95-43h-15v43h15"/>
  </> : <>
    <path d="M136 66h48v48h-48z" fill="var(--surface)"/><path d="M149 80h22v20h-22zM160 66V42m0 72v25m-24-49h-25m73 0h25M137 67l-18-18m65 18 18-18m-65 65-18 18m65-18 18 18"/><circle cx="160" cy="37" r="5"/><circle cx="160" cy="144" r="5"/><circle cx="106" cy="90" r="5"/><circle cx="214" cy="90" r="5"/>
  </>}
  <path d="M60 56h16m-8-8v16m172 59h16m-8-8v16"/><circle cx="238" cy="47" r="4"/>
  </g>
</svg>
