<section id="arcade" class="container section arcade-section">
  <div class="arcade-copy"><p class="eyebrow">03 / SIDE QUEST</p><h2>A little less scroll.<br /><span>A little more play.</span></h2><p>Take a detour through the grid. Collect five signal packets in as few moves as you can.</p><p class="muted">No timer. No enemies. Just you and the next signal.</p><div class="control-legend"><kbd>↑</kbd><kbd>←</kbd><kbd>↓</kbd><kbd>→</kbd><span>or WASD while the grid is focused</span></div></div>
  <div class="arcade-machine panel">
    <div class="window-bar"><span>SIGNAL_RUN.EXE</span><span>LOCAL ARCADE</span></div>
    <div class="game-hud"><span>PACKETS <strong id="packets">0 / 5</strong></span><span>MOVES <strong id="moves">0</strong></span></div>
    <div class="game-grid" tabindex="0" role="group" aria-label="Signal Run game grid" aria-describedby="game-status">{Array.from({length:48}, (_, index) => <span class="game-cell" data-cell={index} aria-hidden="true"></span>)}</div>
    <p id="game-status" class="game-status" role="status">Start a run to collect the signals. JavaScript is needed to play.</p>
    <div class="game-controls" hidden><button class="button primary" id="game-start">Start run <span aria-hidden="true">▷</span></button><div class="d-pad" aria-label="Movement controls"><button data-move="up" aria-label="Move up">↑</button><button data-move="left" aria-label="Move left">←</button><button data-move="down" aria-label="Move down">↓</button><button data-move="right" aria-label="Move right">→</button></div></div>
  </div>
</section>
<script>
  const grid = document.querySelector<HTMLElement>('.game-grid');
  const start = document.querySelector<HTMLButtonElement>('#game-start');
  const status = document.querySelector<HTMLElement>('#game-status');
  if (grid && start && status) {
    document.querySelector<HTMLElement>('.game-controls')!.hidden = false;
    status.textContent = 'Ready, player? Start a run. Collect ◆ with your ◈ runner.';
    let player = 40, collected = 0, moves = 0, running = false;
    const targets = [10, 30, 4, 45, 23];
    const render = () => {
      grid.querySelectorAll<HTMLElement>('[data-cell]').forEach((cell, index) => {
        const isPlayer = index === player, target = running && index === targets[collected];
        cell.classList.toggle('runner', isPlayer); cell.classList.toggle('packet', target);
        cell.textContent = isPlayer ? '◈' : target ? '◆' : '';
      });
      document.querySelector('#packets')!.textContent = `${collected} / 5`;
      document.querySelector('#moves')!.textContent = String(moves);
    };
    const position = (cell: number) => `row ${Math.floor(cell / 8) + 1}, column ${cell % 8 + 1}`;
    const move = (direction: string) => {
      if (!running) return;
      const previous = player;
      if (direction === 'up' && player >= 8) player -= 8;
      if (direction === 'down' && player < 40) player += 8;
      if (direction === 'left' && player % 8 > 0) player--;
      if (direction === 'right' && player % 8 < 7) player++;
      if (player === previous) { status.textContent = 'Edge of the grid. Try another direction.'; return; }
      moves++;
      if (player === targets[collected]) collected++;
      if (collected === 5) { running = false; status.textContent = `Run complete! Five packets in ${moves} moves. Play again to find a shorter route.`; start.textContent = 'Play again ↻'; }
      else status.textContent = `${collected} of 5 collected. Runner: ${position(player)}. Next signal: ${position(targets[collected])}.`;
      render();
    };
    start.addEventListener('click', () => {
      player = 40; collected = 0; moves = 0; running = true; start.textContent = 'Restart ↻'; render();
      status.textContent = `Runner: ${position(player)}. Next signal: ${position(targets[0])}.`; grid.focus({preventScroll:true});
    });
    const keys: Record<string, string> = {ArrowUp:'up',w:'up',ArrowDown:'down',s:'down',ArrowLeft:'left',a:'left',ArrowRight:'right',d:'right'};
    grid.addEventListener('keydown', event => { const direction = keys[event.key]; if (direction && running) {event.preventDefault(); move(direction);} });
    document.querySelectorAll<HTMLButtonElement>('[data-move]').forEach(button => button.addEventListener('click', () => move(button.dataset.move!)));
    render();
  }
</script>
